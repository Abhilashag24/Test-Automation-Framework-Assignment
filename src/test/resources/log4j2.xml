<?xml version="1.0" encoding="UTF-8"?>
<Configuation>
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout
				pattern="%d{YYYY-MM-dd HH:mm:ss} [%t] %highlight{%5p} %level %logger %msg %n"></PatternLayout>
		</Console>
		<File name="FileLogger" fileName="logs/automation.logs"
			append="false">
			<PatternLayout
				pattern="%d{YYYY-MM-dd HH:mm:ss} [%t] %highlight{%5p} %level %logger::%M::%L %msg %n"></PatternLayout>
		</File>
	</Appenders>
	<Loggers>

		<Root level="info">

			<AppenderRef ref="Console"></AppenderRef>
			<AppenderRef ref="FileLogger"></AppenderRef>
		</Root>
	</Loggers>


</Configuation>